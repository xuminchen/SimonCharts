  },
  "files": [
    "dist/index.js",
    "dist/index.d.ts",
    "dist/createChart.d.ts",
    "dist/contracts.d.ts",
    "dist/errors.d.ts",
    "dist/styles.css",
    "README.md"
  ],
  "scripts": {
    "build": "vite build && tsc -b --force",
    "typecheck": "tsc -b"
  },
  "devDependencies": {
    "@simoncharts/chart-engine": "1.0.0-rc.1"
  }
}
