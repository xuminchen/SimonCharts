{
  "name": "@simoncharts/charts",
  "version": "1.0.0-rc.43",
  "private": true,
  "description": "Embeddable Advanced Charts SDK for SimonCharts partners.",
  "license": "UNLICENSED",
  "keywords": [
    "charts",
    "technical-analysis",
    "advanced-charts",
    "browser-sdk"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xuminchen/SimonCharts.git",
    "directory": "packages/chart-workspace"
  },
  "homepage": "https://github.com/xuminchen/SimonCharts#readme",
  "type": "module",
  "sideEffects": [
