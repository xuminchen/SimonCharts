{
  "name": "simoncharts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "typecheck": "tsc -b packages/chart-engine packages/chart-workspace apps/playground apps/workspace-playground",
    "test": "vitest run",
    "test:watch": "vitest",
    "guard:engine-boundary": "node scripts/check-engine-boundary.mjs",
    "guard:public-api": "node scripts/check-public-api.mjs",
    "guard:public-types": "node scripts/check-public-types.mjs",
    "guard:workspace-public-api": "node scripts/check-workspace-public-api.mjs",
    "guard:workspace-public-types": "node scripts/check-workspace-public-types.mjs",
    "guard:sdk-imports": "node scripts/check-sdk-imports.mjs",
    "check:package-consumer": "node scripts/check-package-consumer.mjs",
    "check:package-artifact": "node scripts/check-package-artifact.mjs",
    "check:workspace-package-artifact": "node scripts/check-workspace-package-artifact.mjs",
    "check:workspace-consumer": "node scripts/check-workspace-consumer.mjs",
    "check:host-smoke": "node scripts/check-host-smoke.mjs",
    "check:trading-review-host": "node scripts/check-trading-review-host.mjs",
    "check:package-types": "node scripts/check-package-types.mjs",
    "check:performance": "vitest run packages/chart-engine/src/__tests__/performanceBaseline.test.ts --reporter=dot",
    "check:release-gate": "node scripts/check-release-gate.mjs",
    "check:release-readiness": "node scripts/check-release-readiness.mjs",
    "check:workspace-release-readiness": "node scripts/check-workspace-release-readiness.mjs",
    "check:workspace-release-gate": "node scripts/check-workspace-release-gate.mjs",
    "check:commercial-package-gate": "node scripts/check-commercial-release-gate.mjs --package-only",
    "check:commercial-release-gate": "node scripts/check-commercial-release-gate.mjs",
    "pack:workspace": "node scripts/pack-chart-workspace.mjs",
    "build": "npm run build -w @simoncharts/chart-engine && npm run build -w @simoncharts/charts && npm run build -w @simoncharts/playground && npm run build -w @simoncharts/workspace-playground",
    "dev": "npm run dev -w @simoncharts/playground",
    "dev:workspace": "npm run dev -w @simoncharts/workspace-playground",
    "test:e2e": "playwright test",
    "test:workspace:e2e": "playwright test --project=workspace-playground --workers=1"
  },
  "devDependencies": {
    "@playwright/test": "^1.45.0",
    "@types/node": "^20.14.0",
    "typescript": "^5.5.0",
    "vite": "^5.3.0",
    "vitest": "^1.6.0"
  }
}
