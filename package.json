{
  "name": "simoncharts",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "typecheck": "tsc -b packages/chart-engine apps/playground",
    "test": "vitest run",
    "test:watch": "vitest",
    "guard:engine-boundary": "node scripts/check-engine-boundary.mjs",
    "guard:public-api": "node scripts/check-public-api.mjs",
    "check:package-consumer": "node scripts/check-package-consumer.mjs",
    "build": "npm run build -w @simoncharts/chart-engine && npm run build -w @simoncharts/playground",
    "dev": "npm run dev -w @simoncharts/playground",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.45.0",
    "@types/node": "^20.14.0",
    "typescript": "^5.5.0",
    "vite": "^5.3.0",
    "vitest": "^1.6.0"
  }
}
